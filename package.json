{
  "name": "campuscats",
  "main": "expo-router/entry",
  "version": "1.3.1",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "db:export": "node scripts/database/export-firestore.cjs",
    "db:prepare": "node scripts/database/prepare-import.cjs",
    "db:test": "node --test scripts/database/*.test.cjs && node scripts/database/test-local.cjs",
    "start": "expo start",
    "start:dev": "EXPO_PUBLIC_APP_ENV=development expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "deploy:ios": "npx --yes eas-cli@latest build --platform ios --profile production --auto-submit",
    "web": "expo start --web",
    "test": "jest --watch",
    "test:ci": "jest --runInBand && npm test --prefix functions-catalog",
    "test:coverage": "jest --runInBand --coverage && node scripts/check-coverage.js",
    "test:emulator": "jest --config jest.emulator.config.js --runInBand",
    "emulator:exec": "firebase emulators:exec --project demo-campus-cats-test --only firestore,storage \"npm run test:emulator\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"docs/**/*.md\"",
    "ui:check": "node scripts/check-ui-colors.js",
    "platform:check": "node scripts/check-platform-compat.js",
    "hosting:check": "node scripts/check-hosting.js",
    "hosting:env": "node scripts/check-hosting-environment.js",
    "hosting:build": "if [ -f .env.production.local ]; then set -a && . ./.env.production.local && set +a; fi; npm run hosting:env && expo export --platform web --clear && npm run hosting:check",
    "hosting:serve": "npm run hosting:build && firebase emulators:start --only hosting --project demo-campus-cats-test",
    "postinstall": "patch-package",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run ui:check && npm run platform:check && npm run hosting:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/flash-list": "^2.3.3",
    "@softwhere-uz/react-native-emoji-keyboard": "^0.10.0",
    "@teovilla/react-native-web-maps": "^0.9.5",
    "expo": "~57.0.11",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "1.27.2",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "brace-expansion": "^1.1.21",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "node-fetch": "^2.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "@teovilla/react-native-web-maps": {
      "expo-location": "$expo-location"
    }
  },
  "private": true,
  "description": "<p align=\"center\">   <img src=\"assets/images/campus_cats_logo.png\" alt=\"Campus Cats logo\" width=\"180\" /> </p>",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willakins/Campus-Cats.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/willakins/Campus-Cats/issues"
  },
  "homepage": "https://github.com/willakins/Campus-Cats#readme"
}
