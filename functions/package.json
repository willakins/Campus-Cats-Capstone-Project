{
  "name": "functions",
  "scripts": {
    "build": "node ../scripts/clean-functions-build.js && node ../scripts/generate-functions-platform-info.js && tsc",
    "test": "node --test \"lib/**/*.test.js\"",
    "test:ci": "npm run build && npm test",
    "contract:inaturalist:live": "npm run build && node lib/integrations/inaturalist/inaturalistContract.js",
    "admin:create-club": "npm run build && node lib/admin/createClub.js",
    "admin:migrate-campus-cats": "npm run build && node lib/admin/migrateCampusCatsTenant.js",
    "admin:rename-alerts": "npm run build && node lib/admin/renameAnnouncementsToAlerts.js",
    "admin:rollback-campus-cats": "npm run build && node lib/admin/rollbackCampusCatsTenant.js",
    "admin:sync-universities": "npm run build && node lib/admin/syncUniversityCatalog.js",
    "admin:seed-georgia-tech-university": "npm run build && node lib/admin/seedGeorgiaTechUniversity.js",
    "admin:seed-development": "npm run build && node lib/admin/seedDevelopment.js",
    "admin:overlay-development-trial": "npm run build && node lib/admin/overlayDevelopmentTrial.js",
    "admin:enable-campus-cats-billing": "npm run build && node lib/admin/enableCampusCatsBilling.js",
    "build:watch": "node ../scripts/watch-functions-build.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/bigquery": "^9.2.0",
    "@sendgrid/mail": "^8.1.6",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "stripe": "^22.4.0",
    "tldts": "^7.4.18",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/tz-lookup": "^6.1.2",
    "firebase-tools": "^15.33.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
